{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "URPC_BUILD_TESTS": "ON",
        "URPC_BUILD_BENCH": "OFF",
        "URPC_BUILD_EXAMPLES": "ON",
        "URPC_BUILD_INTEROP": "ON"
      }
    },
    {
      "name": "release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "URPC_BUILD_TESTS": "ON",
        "URPC_BUILD_BENCH": "ON",
        "URPC_BUILD_EXAMPLES": "ON",
        "URPC_BUILD_INTEROP": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" }
  ],
  "testPresets": [
    {
      "name": "verify",
      "configurePreset": "release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "bench",
      "configurePreset": "release",
      "filter": { "include": { "label": "bench" } },
      "output": { "outputOnFailure": true }
    },
    {
      "name": "interop",
      "configurePreset": "release",
      "filter": { "include": { "label": "interop" } },
      "output": { "outputOnFailure": true }
    }
  ]
}
